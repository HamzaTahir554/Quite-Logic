{
  "name": "quitelogic",
  "version": "1.0.0",
  "private": true,
  "description": "Quite Logic — calm, precise software",
  "type": "module",
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "build": "next build",
    "build:hostinger": "next build --webpack",
    "lint": "eslint .",
    "admin:create": "tsx scripts/setup-admin.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:seed": "tsx scripts/seed-portfolio.ts",
    "test:admin": "tsx scripts/test-admin.ts",
    "test:avatars": "node --conditions=react-server --import tsx scripts/test-avatars.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:gmail": "node --conditions=react-server --import tsx scripts/test-gmail.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@googleapis/gmail": "^22.0.2",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^14.3.0",
    "google-auth-library": "^11.3.1",
    "gsap": "^3.15.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2",
    "next": "^16.4.1",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mongodb-memory-server": "^11.3.0",
    "nock": "^15.0.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
