NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional exact additional trusted website origins, comma-separated; no wildcards.
ALLOWED_ORIGINS=
# Private hosted PostgreSQL connection string (Neon, Supabase, or another provider).
DATABASE_URL=
# Optional migration target only; runtime uses DATABASE_URL after cutover.
SUPABASE_DATABASE_URL=
# Used only by npm run admin:setup; remove the password after setup.
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_PASSWORD=
# Server-only Resend credentials. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Outgoing Resend SMTP. SMTP_PASSWORD may be blank to reuse RESEND_API_KEY.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM="Quiet Logic <contact@quitelogic.com>"
EMAIL_TO=contact@quitelogic.com
EMAIL_REPLY_FROM="Quiet Logic <contact@quitelogic.com>"
