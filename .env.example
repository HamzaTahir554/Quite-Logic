# Official Calendly embedding needs no API token.
# Meeting URL: lib/company.ts

# Admin Gmail API (separate from transactional SMTP; server-only).
# See docs/GMAIL-SETUP.md. Never use NEXT_PUBLIC_ for credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to APP_URL + /api/admin/gmail/callback.
GOOGLE_REDIRECT_URI=
# Generate a dedicated 32-byte base64 key; keep stable and back it up securely.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Recommended: restrict OAuth connection to the official Gmail/Workspace mailbox.
GMAIL_ACCOUNT_EMAIL=
